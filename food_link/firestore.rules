rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role in ['provider', 'receiver'];
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if request.auth != null;

      // A provider may only create a donation under their own uid, in the
      // 'active' state, and only if the submitted prediction still leaves
      // at least 4 hours of remaining shelf life computed from the
      // submitted prepTime against the server's write-time clock. This is
      // a server-side backstop for the client-side 4-hour safety check —
      // it re-derives the arithmetic, but trusts that predictedShelfLife
      // itself came from a legitimate call to the ML backend (there is no
      // way to re-verify the model's output from a security rule alone).
      allow create: if request.auth != null
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.predictedShelfLife is number
        && request.resource.data.prepTime is timestamp
        && (
          request.resource.data.predictedShelfLife -
          (request.time.toMillis() - request.resource.data.prepTime.toMillis()) / 3600000.0
        ) >= 4.0;

      allow update: if request.auth != null && (
        // Provider managing their own posting.
        resource.data.providerId == request.auth.uid ||
        // Receiver claiming an active donation: only status/acceptedBy*
        // fields may change, and only from active -> accepted.
        (
          resource.data.status == 'active' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedById == request.auth.uid &&
          request.resource.data.providerId == resource.data.providerId &&
          request.resource.data.foodType == resource.data.foodType &&
          request.resource.data.predictedShelfLife == resource.data.predictedShelfLife
        ) ||
        // Receiver releasing their own claim: accepted -> active.
        (
          resource.data.acceptedById == request.auth.uid &&
          request.resource.data.status == 'active'
        )
      );

      allow delete: if false;
    }
  }
}
